+function hintForFloor(){
+  var fl=G.floors[G.depth]; if(!fl) return 'Hint — the stones say nothing of this floor.';
+  var keyRoom=Object.keys(fl.rooms).filter(function(s){return (fl.rooms[s].items||[]).indexOf('floor-key')>=0;})[0];
