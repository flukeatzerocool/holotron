+  var stairs=Object.keys(fl.rooms).filter(function(s){return fl.rooms[s].archetype==='descending-stair';});
+  var bits=[];
+  function bare(s){ return String(s||'').replace(/^(?:The|A|An)\s+/,''); } // avoid "the The X"
+  if(keyRoom) bits.push('the key rests in the '+bare(fl.rooms[keyRoom].name));
+  if(refill) bits.push('a wax-cake waits in the '+bare(fl.rooms[refill].name));
+  if(stairs.length) bits.push('the fast stair is the '+bare(fl.rooms[stairs[0]].name));
+  return bits.length ? ('Hint — '+bits.join('; ')+'.') : 'Hint — the stones keep their counsel.';
